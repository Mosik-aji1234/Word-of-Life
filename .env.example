# Copy this file to .env and fill in your values
PORT=3000

# Supabase public browser config
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Gmail credentials for counseling form email notifications
# How to get GMAIL_APP_PASSWORD:
# 1. Go to myaccount.google.com → Security
# 2. Enable 2-Step Verification (required)
# 3. Search "App passwords" → Create one → name it "Word of Life"
# 4. Copy the 16-character password and paste it below
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
